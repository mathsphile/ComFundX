# Copy to .env and fill in local values. Never commit real secrets.

# Prisma (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Stellar network (Testnet defaults shown)
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Native XLM Stellar Asset Contract on Testnet
NEXT_PUBLIC_NATIVE_XLM_CONTRACT="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"

# CrowdFundX escrow contract deployed on Testnet
NEXT_PUBLIC_CROWDFUND_CONTRACT_ID="CDXS34F6CM4IVYFLGZ2BTVXZKP5PBDDB3IR6N3N4XCF7ZL3TE3FEQKVF"

# Auth — set a strong random value locally; never commit real secrets
JWT_SECRET="replace_with_a_long_random_secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
